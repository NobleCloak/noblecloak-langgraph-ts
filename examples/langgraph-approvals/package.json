{
  "name": "@noblecloak/example-langgraph-approvals",
  "version": "0.0.0",
  "private": true,
  "description": "A LangGraph agent whose refund tool needs approval: the agent, the resumer worker and the approver run as separate processes against the mock. No account, no credentials.",
  "license": "Apache-2.0",
  "author": "NobleCloak",
  "type": "module",
  "scripts": {
    "start": "node dist/bin/demo.js",
    "start:browser": "node dist/bin/browser.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@langchain/core": "1.3.4",
    "@langchain/langgraph": "1.6.1",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "@noblecloak/client": "0.13.0",
    "@noblecloak/langgraph": "workspace:*",
    "@noblecloak/spec": "0.12.0",
    "langchain": "1.6.1",
    "zod": "4.6.7"
  }
}
